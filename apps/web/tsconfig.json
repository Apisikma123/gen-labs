{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@genlab/simulation-core": ["./src/packages/simulation-core/src/index.ts"],
      "@genlab/simulation-core/*": ["./src/packages/simulation-core/src/*"],
      "@genlab/simulation-types": ["./src/packages/simulation-types/src/index.ts"],
      "@genlab/simulation-types/*": ["./src/packages/simulation-types/src/*"],
      "@simula/simulation-core": ["./src/packages/simulation-core/src/index.ts"],
      "@simula/simulation-core/*": ["./src/packages/simulation-core/src/*"],
      "@simula/simulation-types": ["./src/packages/simulation-types/src/index.ts"],
      "@simula/simulation-types/*": ["./src/packages/simulation-types/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
